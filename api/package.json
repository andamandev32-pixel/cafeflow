{
  "name": "cafeflow-api",
  "version": "0.1.0",
  "private": true,
  "description": "CafeFlow — เซิร์ฟเวอร์ในร้าน (แหล่งความจริงของวันทำการ)",
  "//type": "ห้ามใส่ \"type\": \"module\" — shared/ ใช้ UMD ที่ต้อง require() ได้ และโปรเจกต์นี้ตั้งใจไม่มี bundler",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "reset": "node src/db/migrate.js --reset && node src/db/seed.js",
    "test": "node --test test/*.test.js",
    "fetch-tessdata": "node src/db/fetch-tessdata.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.4",
    "@napi-rs/canvas": "^1.0.9",
    "argon2": "^0.44.0",
    "fastify": "^5.2.1",
    "jsqr": "^1.4.0",
    "pg": "^8.13.1",
    "pino-pretty": "^13.1.3",
    "promptpay-qr": "^0.5.0",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
